# VisionGuard FastAPI Inference Backend Configuration

HOST=0.0.0.0
PORT=8000
DEBUG=false

# Allowed CORS Origins (JSON list or comma-separated strings)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001"]

# Rate Limiting (max frames/requests per client IP per minute)
RATE_LIMIT_PER_MINUTE=60

# Model Paths (relative to backend/ or absolute)
COMPONENT_MODEL_PATH=models/fine_best.pt
PCB_SEG_MODEL_PATH=models/pcb-seg.pt

# Inference Device (auto, cpu, cuda)
DEVICE=auto

# Hardware Copilot AI Keys (optional, for /api/assistant streaming)
# If neither is set, assistant returns 503 assistant_not_configured
GEMINI_API_KEY=
OPENAI_API_KEY=
